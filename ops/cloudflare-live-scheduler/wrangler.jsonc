{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "basketball-brawl-live-scheduler",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {"SCHEDULER_ENABLED": "false"},
  "triggers": {"crons": ["*/5 * * * *"]},
  "durable_objects": {
    "bindings": [{"name": "DISPATCH_GUARD", "class_name": "DispatchGuard"}]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["DispatchGuard"]}],
  "observability": {"enabled": true, "head_sampling_rate": 1}
}
